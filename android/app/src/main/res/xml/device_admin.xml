<?xml version="1.0" encoding="utf-8"?>
<!-- What the app may do as a "device admin app" (the optional uninstall
     protection): only lock the screen. Nothing else. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
